APP_BASE_URL=http://localhost:4173
PORT=4173
# Leave these blank for local SQLite. Set all three to use your Supabase project.
# Copy DATABASE_URL from Supabase > Connect > Transaction pooler (port 6543).
DATABASE_URL=
# Optional session/direct URL for migrations; defaults to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Optional custom database CA certificate (PEM). Supabase's public CA is bundled.
# For Vercel, use DATABASE_SSL_CA for an override; local files can use DATABASE_SSL_CA_FILE.
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=
SUPABASE_URL=
# Server secret key (sb_secret_...) or legacy service_role key. Never a publishable/anon key.
SUPABASE_SECRET_KEY=
# Required for the first administrator on Vercel. Use a random secret of at least 32 characters.
ADMIN_SETUP_TOKEN=
# Optional: restrict initial administrator creation to your email address.
ADMIN_EMAIL=
# Begin with test keys. Keep all secret keys in .env, never in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
